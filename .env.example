# Shared secret for the Cloudflare Worker relay (the OpenAI key lives in the
# Worker, not here). Copy this file to `.env.local` and fill it in.
# Never commit `.env.local`.
VITE_RELAY_SECRET=

# Unused by the relay path — startSttStream accepts and ignores it, but main.ts
# still gates startup on it being present.
VITE_STT_API_KEY=
